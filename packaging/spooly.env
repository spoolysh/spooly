# Required
# openssl rand -base64 32
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in emails of admins, who create mailboxes and reach every mailbox
ADMIN_EMAILS=

# Server
#PORT=8080
HOSTNAME=http://localhost:8080
# Comma-separated email domains that can sign in; empty allows all
#ALLOWED_DOMAINS=example.com

# Database: SQLite, or PostgreSQL with postgres://user:pass@host/db
DATABASE_URL=file:/var/lib/spooly/spooly.db

# Raw message storage: local, s3, gcs, or memory (lost on restart)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/var/lib/spooly/storage
# s3: Amazon S3, Cloudflare R2, MinIO; credentials from the usual AWS_* variables
#S3_BUCKET=
# gcs: credentials from Application Default Credentials
#GCS_BUCKET=

# Retention. A message deleted for good can be restored by an admin for this
# long, its raw source kept; 0 removes it at once
#EXPUNGE_AFTER=168h
# How long events are kept: for sync clients' lists of changes, and as
# deliveries' history; at least EXPUNGE_AFTER, or 0 to keep them forever
#EVENTS_RETENTION=1080h

# Sending: smtp, cloudflare, or empty to turn it off
#MAIL_TRANSPORT=
# Keep a copy of sent mail in the mailbox's Sent folder; false keeps none,
# only each recipient's delivery, as for an app's notifications
#SAVE_TO_SENT=true
# smtp: a relay, such as Google Workspace's smtp-relay.gmail.com; port 465
# is TLS from the start, any other must offer STARTTLS, unless the relay is
# this machine, such as Mailpit (SMTP_HOST=localhost, SMTP_PORT=1025)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
# cloudflare: an API token with Email Sending: Edit (needs Workers Paid)
#CLOUDFLARE_API_TOKEN=
