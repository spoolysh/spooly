# Required
# openssl rand -base64 32
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in emails of admins, who create mailboxes and reach every mailbox
ADMIN_EMAILS=

# Server
#PORT=8080
HOSTNAME=http://localhost:8080
# Comma-separated email domains that can sign in; empty allows all
#ALLOWED_DOMAINS=example.com

# Database: SQLite, or PostgreSQL with postgres://user:pass@host/db
DATABASE_URL=file:/var/lib/spooly/spooly.db

# Raw message storage: local, s3, gcs, or memory (lost on restart)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/var/lib/spooly/storage
# s3: Amazon S3, Cloudflare R2, MinIO; credentials from the usual AWS_* variables
#S3_BUCKET=
# gcs: credentials from Application Default Credentials
#GCS_BUCKET=
