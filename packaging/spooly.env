# Required
# openssl rand -base64 32
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in emails of admins, who create accounts and reach every account
ADMIN_EMAILS=

# Server
#PORT=8080
HOSTNAME=http://localhost:8080
# Comma-separated email domains that can sign in; empty allows all
#ALLOWED_DOMAINS=example.com

# Database: SQLite, or PostgreSQL with postgres://user:pass@host/db
DATABASE_URL=file:/var/lib/spooly/spooly.db

# Raw message storage: local, s3, gcs, or memory (lost on restart)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/var/lib/spooly/storage
# s3: Amazon S3, Cloudflare R2, MinIO; credentials from the usual AWS_* variables
#S3_BUCKET=
# gcs: credentials from Application Default Credentials
#GCS_BUCKET=

# POP3, started by `spooly serve --mail` and `spooly mail`; an empty POP3_ADDR
# disables it
#POP3_ADDR=:1110
#POP3S_ADDR=:995
# keep, archive, or trash
#POP3_DELETE=keep
# false: downloading doesn't mark messages read
#POP3_MARK_READ=true
#POP3_MAX_MESSAGES=250

# IMAP, started by `spooly serve --mail` and `spooly mail`; an empty IMAP_ADDR
# disables it
#IMAP_ADDR=:1143
#IMAPS_ADDR=:993

# TLS for the mail protocols (STARTTLS, POP3S, IMAPS); logins then need TLS
#MAIL_TLS_CERT=/path/to/cert.pem
#MAIL_TLS_KEY=/path/to/key.pem
