[Unit]
Description=Spooly mail backend
Documentation=https://docs.spooly.sh
After=network-online.target
Wants=network-online.target

[Service]
User=spooly
Group=spooly
EnvironmentFile=/etc/spooly/spooly.env
# public/ is read from the working directory
WorkingDirectory=/usr/share/spooly
ExecStart=/usr/bin/spooly serve --migrate
Restart=on-failure
StateDirectory=spooly
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
