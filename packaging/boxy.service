[Unit]
Description=Boxy mail backend
Documentation=https://docs.boxy.sh
After=network-online.target
Wants=network-online.target

[Service]
User=boxy
Group=boxy
EnvironmentFile=/etc/boxy/boxy.env
# public/ is read from the working directory
WorkingDirectory=/usr/share/boxy
# Add --mail for POP3 and IMAP: systemctl edit boxy
ExecStart=/usr/bin/boxy serve --migrate
Restart=on-failure
StateDirectory=boxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
